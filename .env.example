# Copy to .env and fill in. Never commit .env — it is gitignored.

# Anthropic API key — Claude API direct (not Bedrock). Required.
# In production this is set in the Render dashboard, not in a file.
ANTHROPIC_API_KEY=YOUR_API_KEY

# Exact origin allowed to call the API. No wildcard.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Where uploads, reviews, and progress records are written.
LOCAL_DATA_DIR=./local-data
