# Copy to .env and fill in. Never commit .env — it is gitignored.

# Which provider serves the model calls: openrouter (default) or anthropic.
# Reverting to Claude direct is this one line plus a restart — no code change.
LLM_PROVIDER=openrouter

# --- LLM_PROVIDER=openrouter ------------------------------------------------ #
# Required when openrouter is selected. Set in the Render dashboard in production.
OPENROUTER_API_KEY=YOUR_API_KEY
# Verified to support BOTH image input and structured outputs, at 262k context.
# Do NOT use moonshotai/kimi-k2 — it is text-only with no structured output.
OPENROUTER_MODEL=moonshotai/kimi-k2.6
# Ceiling on completion tokens per request. The evaluate stage asks for 32000.
OPENROUTER_MAX_COMPLETION_TOKENS=32000
# Optional: exclude named OpenRouter providers from routing, comma-separated.
# e.g. OPENROUTER_IGNORE_PROVIDERS=DeepInfra,Sail Research
OPENROUTER_IGNORE_PROVIDERS=

# --- LLM_PROVIDER=anthropic ------------------------------------------------- #
# Required only when anthropic is selected. Claude API direct, not Bedrock.
ANTHROPIC_API_KEY=YOUR_API_KEY
ANTHROPIC_MODEL=claude-sonnet-5

# Exact origin allowed to call the API. No wildcard.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Where uploads, reviews, and progress records are written.
LOCAL_DATA_DIR=./local-data
