# Copy to .env and fill in. Never commit .env — it is gitignored.

# Which provider serves the model calls: openrouter (default) or anthropic.
# Reverting to Claude direct is this one line plus a restart — no code change.
LLM_PROVIDER=openrouter

# --- LLM_PROVIDER=openrouter ------------------------------------------------ #
# Required when openrouter is selected. Set in the Render dashboard in production.
OPENROUTER_API_KEY=YOUR_API_KEY
# Verified to support BOTH image input and structured outputs, at 262k context.
# Do NOT use moonshotai/kimi-k2 — it is text-only with no structured output.
OPENROUTER_MODEL=moonshotai/kimi-k2.6
# Hard ceiling on completion tokens per request. Headroom, not a target: the
# largest stage (evaluate) asks for 64000.
OPENROUTER_MAX_COMPLETION_TOKENS=128000
# Ordered provider allow-list, comma-separated SLUGS (not display names). Verified
# against /api/v1/providers and the model's /endpoints — see README.
OPENROUTER_PROVIDER_ORDER=coreweave,decart,inceptron
# Off by default: a request none of the above can serve FAILS rather than routing
# somewhere unlisted. Set to 1 to allow OpenRouter to fall back anywhere.
OPENROUTER_ALLOW_FALLBACKS=
# Hard-fail a call whose response came from a provider outside the order above, or
# that reported no provider at all. On by default: a route that ignored the lock is
# the exact failure the lock exists to prevent, and it went unnoticed once because
# it only logged. Set to 0 to downgrade to a log line.
OPENROUTER_ENFORCE_PROVIDER_LOCK=1
# Wall-clock ceiling per model call, seconds. There is no server-side deadline, so
# without this a stalled upstream hangs indefinitely — one already ran 94 minutes.
# Evaluate is the stage most likely to legitimately approach it, and at 120s it did:
# a real SoW review died when evaluate hit that ceiling twice. Hence 300.
# A stage that trips this retries once a step down in effort, so budget 2 x this.
OPENROUTER_TIMEOUT_SECONDS=300
# Optional: exclude named OpenRouter providers from routing, comma-separated.
# e.g. OPENROUTER_IGNORE_PROVIDERS=DeepInfra,Sail Research
OPENROUTER_IGNORE_PROVIDERS=

# --- LLM_PROVIDER=anthropic ------------------------------------------------- #
# Required only when anthropic is selected. Claude API direct, not Bedrock.
ANTHROPIC_API_KEY=YOUR_API_KEY
ANTHROPIC_MODEL=claude-sonnet-5

# Shared demo access token. Required: with this unset every gated route returns
# 401, deliberately, so a forgotten variable cannot leave the API wide open.
# The frontend prompts for it and sends it as the X-Demo-Token header.
DEMO_ACCESS_TOKEN=choose-a-long-random-string

# Exact origin allowed to call the API. No wildcard.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Where uploads, reviews, and progress records are written.
LOCAL_DATA_DIR=./local-data
