# Base URL of the deployed HTTP API — the Render service URL, read at BUILD time by
# Vite, so changing it needs a redeploy rather than a restart. Defaults to the local
# uvicorn server when unset.
#
# ("the ApiUrl output from the SAM stack" was the previous wording here. There is no
#  SAM stack and no AWS in this project — backend on Render, frontend on Vercel.)
#
# This deployment: https://trust7-gatekeeper-backend-docker.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000
